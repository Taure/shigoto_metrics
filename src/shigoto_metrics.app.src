{application, shigoto_metrics, [
    {description, "Prometheus metrics collectors and Grafana dashboard for shigoto"},
    {vsn, "git"},
    {registered, [shigoto_metrics_sup]},
    {mod, {shigoto_metrics_app, []}},
    {applications, [
        kernel,
        stdlib,
        telemetry,
        prometheus
    ]},
    {env, [
        {auto_setup, true}
    ]},
    {modules, []},
    {licenses, ["MIT"]},
    {links, [{"GitHub", "https://github.com/Taure/shigoto_metrics"}]}
]}.
